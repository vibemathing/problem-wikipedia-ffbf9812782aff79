{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/runtime-adapter.v1.json",
  "title": "Vibe Mathing Runtime Adapter Declaration",
  "description": "A side-effect-free declaration for one registered runtime adapter. An adapter declaration is a capability and transport contract, not evidence of a live backend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_kind",
    "channel",
    "version",
    "capabilities",
    "maturity",
    "input_media",
    "output_media",
    "budgets",
    "fingerprints",
    "claim_ceiling",
    "side_effects"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "adapter_id": {
      "type": "string",
      "pattern": "^adapter:[a-z0-9][a-z0-9.-]*$"
    },
    "adapter_kind": {"enum": ["reference", "synthetic"]},
    "channel": {
      "enum": ["local_pi", "web_chatgpt", "github_candidate", "prove2me"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "maturity": {
      "enum": [
        "surveyed",
        "source_locked",
        "installed",
        "smoke_checked",
        "evidence_capable",
        "verifier_admitted"
      ]
    },
    "input_media": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "output_media": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "budgets": {"$ref": "#/$defs/budgets"},
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "tool", "model", "environment"],
      "properties": {
        "adapter": {"$ref": "#/$defs/fingerprint"},
        "tool": {"$ref": "#/$defs/fingerprint"},
        "model": {"$ref": "#/$defs/fingerprint"},
        "environment": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "claim_ceiling": {
      "enum": ["candidate_only", "blocked_only", "transport_only"]
    },
    "side_effects": {"$ref": "#/$defs/no_side_effects"},
    "notes": {"type": "string", "maxLength": 4096}
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "fingerprint", "fingerprint_status"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "fingerprint": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "fingerprint_status": {
          "enum": ["verified", "unverified", "unavailable"]
        }
      }
    },
    "positive_integer": {"type": "integer", "minimum": 1},
    "nonnegative_integer": {"type": "integer", "minimum": 0},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_output_bytes"],
      "properties": {
        "timeout_seconds": {"$ref": "#/$defs/positive_integer"},
        "max_output_bytes": {"$ref": "#/$defs/positive_integer"},
        "max_files": {"$ref": "#/$defs/positive_integer"},
        "max_memory_bytes": {"$ref": "#/$defs/positive_integer"},
        "max_cpu_seconds": {"$ref": "#/$defs/positive_integer"},
        "max_retries": {"$ref": "#/$defs/nonnegative_integer"},
        "max_transitions": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "no_side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "filesystem",
        "subprocess",
        "browser",
        "github",
        "prove2me",
        "tmux"
      ],
      "properties": {
        "network": {"const": false},
        "filesystem": {"const": false},
        "subprocess": {"const": false},
        "browser": {"const": false},
        "github": {"const": false},
        "prove2me": {"const": false},
        "tmux": {"const": false}
      }
    }
  }
}
