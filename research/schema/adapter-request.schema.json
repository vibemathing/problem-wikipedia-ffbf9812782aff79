{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/adapter-request.v1.json",
  "title": "Vibe Mathing Runtime Adapter Request",
  "description": "A Coordinator-bound, immutable request for a side-effect-free runtime adapter. The request identifies one mathematical obligation but does not assert a mathematical result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "coordinator_id",
    "job_id",
    "run_instance_id",
    "attempt_id",
    "graph_id",
    "obligation_id",
    "route_id",
    "session_id",
    "correlation_id",
    "causation_id",
    "dedupe_key",
    "problem_id",
    "problem_contract_sha256",
    "adapter_id",
    "channel",
    "requested_capabilities",
    "input",
    "input_digest",
    "budgets",
    "expected_claim_ceiling",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {
      "type": "string",
      "pattern": "^adapter-request:[a-z0-9][a-z0-9.-]*$"
    },
    "coordinator_id": {
      "type": "string",
      "pattern": "^coordinator:[a-z0-9][a-z0-9.-]*$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project:[a-z0-9][a-z0-9.-]*$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job:[a-z0-9][a-z0-9.-]*$"
    },
    "run_instance_id": {
      "type": "string",
      "pattern": "^(?:run|run-instance):[a-z0-9][a-z0-9.-]*$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt:[a-z0-9][a-z0-9.-]*$"
    },
    "graph_id": {
      "type": "string",
      "pattern": "^graph:[a-z0-9][a-z0-9.-]*$"
    },
    "obligation_id": {
      "type": "string",
      "pattern": "^obligation:[a-z0-9][a-z0-9.-]*$"
    },
    "route_id": {
      "type": "string",
      "pattern": "^route:[a-z0-9][a-z0-9.-]*$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^session:[a-z0-9][a-z0-9.-]*$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^correlation:[a-z0-9][a-z0-9.-]*$"
    },
    "causation_id": {
      "type": "string",
      "pattern": "^causation:[a-z0-9][a-z0-9.-]*$"
    },
    "dedupe_key": {
      "type": "string",
      "pattern": "^dedupe:[a-z0-9][a-z0-9.-]*$"
    },
    "problem_id": {
      "type": "string",
      "pattern": "^problem:[a-z0-9][a-z0-9.-]*$"
    },
    "problem_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^adapter:[a-z0-9][a-z0-9.-]*$"
    },
    "channel": {
      "enum": ["local_pi", "web_chatgpt", "github_candidate", "prove2me"]
    },
    "principal": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 256
    },
    "requested_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "input": {"$ref": "#/$defs/input"},
    "input_digest": {"$ref": "#/$defs/digest"},
    "budgets": {"$ref": "#/$defs/budgets"},
    "expected_claim_ceiling": {
      "enum": ["candidate_only", "blocked_only", "transport_only"]
    },
    "task_package_sha256": {"$ref": "#/$defs/digest"},
    "research_program": {"$ref": "#/$defs/research_program"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"channel": {"const": "web_chatgpt"}}},
      "then": {"required": ["research_program"]}
    },
    {
      "if": {"required": ["research_program"]},
      "then": {"required": ["task_package_sha256"]}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "positive_integer": {"type": "integer", "minimum": 1},
    "nonnegative_integer": {"type": "integer", "minimum": 0},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "payload"],
      "properties": {
        "media_type": {"type": "string", "minLength": 1, "maxLength": 256},
        "payload": {}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_output_bytes"],
      "properties": {
        "timeout_seconds": {"$ref": "#/$defs/positive_integer"},
        "max_output_bytes": {"$ref": "#/$defs/positive_integer"},
        "max_files": {"$ref": "#/$defs/positive_integer"},
        "max_memory_bytes": {"$ref": "#/$defs/positive_integer"},
        "max_cpu_seconds": {"$ref": "#/$defs/positive_integer"},
        "max_retries": {"$ref": "#/$defs/nonnegative_integer"},
        "max_transitions": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "research_program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "root_mission",
        "canonical_conversation",
        "task_package",
        "route_portfolio",
        "mandatory_phases",
        "anti_early_stop",
        "prompt_characters"
      ],
      "properties": {
        "mode": {"const": "long_horizon_program"},
        "root_mission": {"type": "string", "minLength": 1, "maxLength": 16384},
        "canonical_conversation": {"$ref": "#/$defs/canonical_conversation"},
        "task_package": {"$ref": "#/$defs/task_package"},
        "route_portfolio": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "mandatory_phases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "anti_early_stop": {"$ref": "#/$defs/anti_early_stop"},
        "prompt_characters": {"type": "integer", "minimum": 3000},
        "prompt_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "canonical_conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation_id", "url", "canonical", "conversation_count"],
      "properties": {
        "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "url": {"type": "string", "pattern": "^https?://", "maxLength": 2048},
        "canonical": {"const": true},
        "conversation_count": {"const": 1}
      }
    },
    "task_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "sha256"],
      "properties": {
        "package_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$"
        },
        "sha256": {"$ref": "#/$defs/digest"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "anti_early_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "continue_after_each_phase",
        "switch_route_on_blocker",
        "stop_conditions"
      ],
      "properties": {
        "enabled": {"const": true},
        "continue_after_each_phase": {"const": true},
        "switch_route_on_blocker": {"const": true},
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  }
}
