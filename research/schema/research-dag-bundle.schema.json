{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/research-dag-bundle.v1.json",
  "title": "Vibe Mathing versioned research DAG bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "problem",
    "cutoff",
    "graphs",
    "bindings",
    "state_vector",
    "observed_counts",
    "lineage",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "research-dag-bundle.v1"},
    "bundle_id": {"type": "string", "pattern": "^dag-bundle:[a-z0-9][a-z0-9.-]*:v[0-9]+$"},
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_id", "problem_contract_sha256", "repository", "attempt_id", "original_obligation_graph_id"],
      "properties": {
        "problem_id": {"type": "string", "pattern": "^problem:[a-z0-9][a-z0-9.-]*$"},
        "problem_contract_sha256": {"$ref": "#/$defs/sha256"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "attempt_id": {"type": "string", "pattern": "^attempt:[a-z0-9][a-z0-9.-]*$"},
        "original_obligation_graph_id": {"type": "string", "minLength": 1}
      }
    },
    "cutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "repository_commit", "source_status_class", "source_inventory_path", "source_inventory_sha256"],
      "properties": {
        "captured_at": {"type": "string", "format": "date-time"},
        "repository_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_status_class": {"enum": ["open", "answered", "resolved", "solved", "unknown"]},
        "source_inventory_path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
        "source_inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "graphs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_plan", "execution_run", "mathematical_obligations", "evidence_admission"],
      "properties": {
        "execution_plan": {"$ref": "#/$defs/graph"},
        "execution_run": {"$ref": "#/$defs/graph"},
        "mathematical_obligations": {"$ref": "#/$defs/graph"},
        "evidence_admission": {"$ref": "#/$defs/graph"}
      }
    },
    "bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/binding"}
    },
    "state_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_status_class",
        "candidate_status",
        "platform_status",
        "native_replay_status",
        "repository_admission_status",
        "mathematical_outcome",
        "root_closed"
      ],
      "properties": {
        "source_status_class": {"enum": ["open", "answered", "resolved", "solved", "unknown"]},
        "candidate_status": {"enum": ["none", "candidate_only", "root_refutation_candidate", "withdrawn"]},
        "platform_status": {"enum": ["not_submitted", "submitted", "accepted", "rejected", "unknown"]},
        "native_replay_status": {"enum": ["not_run", "passed", "failed", "stale"]},
        "repository_admission_status": {"enum": ["absent", "pending", "admitted", "conflict"]},
        "mathematical_outcome": {"enum": ["undetermined", "supported", "established", "refuted", "inconclusive", "withdrawn"]},
        "root_closed": {"type": "boolean"}
      }
    },
    "observed_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_obligation_nodes",
        "visible_candidate_series",
        "candidate_artifact_ledger",
        "formal_declarations",
        "root_dependency_nodes",
        "root_dependency_edges",
        "evidence_links",
        "results",
        "solutions",
        "web_writer_transactions"
      ],
      "properties": {
        "original_obligation_nodes": {"type": "integer", "minimum": 0},
        "visible_candidate_series": {"type": "integer", "minimum": 0},
        "candidate_artifact_ledger": {"type": "integer", "minimum": 0},
        "formal_declarations": {"type": "integer", "minimum": 0},
        "root_dependency_nodes": {"type": "integer", "minimum": 0},
        "root_dependency_edges": {"type": "integer", "minimum": 0},
        "evidence_links": {"type": "integer", "minimum": 0},
        "results": {"type": "integer", "minimum": 0},
        "solutions": {"type": "integer", "minimum": 0},
        "web_writer_transactions": {"type": "integer", "minimum": 0}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commits", "chatgpt", "pi_sessions", "codex_sessions"],
      "properties": {
        "git_commits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha", "observed_at", "subject", "canonical_main"],
            "properties": {
              "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
              "observed_at": {"type": "string", "format": "date-time"},
              "subject": {"type": "string", "minLength": 1},
              "canonical_main": {"type": "boolean"}
            }
          }
        },
        "chatgpt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "conversation_uuid", "initial_export_sha256", "transactions"],
          "properties": {
            "project_id": {"type": "string", "minLength": 1},
            "conversation_uuid": {"type": "string", "format": "uuid"},
            "initial_export_sha256": {"$ref": "#/$defs/sha256"},
            "transactions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sent_at", "message_sha256", "delivery_observed"],
                "properties": {
                  "sent_at": {"type": "string", "format": "date-time"},
                  "message_sha256": {"$ref": "#/$defs/sha256"},
                  "delivery_observed": {"type": "boolean"}
                }
              }
            }
          }
        },
        "pi_sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["session_id", "role", "observable_scope"],
            "properties": {
              "session_id": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "observable_scope": {"type": "string", "minLength": 1}
            }
          }
        },
        "codex_sessions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surviving_local_bindings", "observation"],
          "properties": {
            "surviving_local_bindings": {"type": "integer", "minimum": 0},
            "observation": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "status", "label", "artifacts", "metadata"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$"},
        "kind": {
          "enum": [
            "plan_step", "run_event", "candidate", "transport", "platform_event", "publication",
            "definition", "lemma", "counterexample_target", "root_claim", "formal_theorem",
            "candidate_gate", "identity_gate", "kernel_gate", "axiom_gate", "faithfulness_gate",
            "independent_review_gate", "external_replay_gate", "evidence_link_gate", "result_gate"
          ]
        },
        "status": {
          "enum": ["planned", "running", "succeeded", "failed", "blocked", "stale", "open", "closed", "accepted", "candidate_only", "absent", "withdrawn"]
        },
        "label": {"type": "string", "minLength": 1},
        "artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "metadata": {"type": "object"},
        "plan_node_id": {"type": "string", "pattern": "^plan:[a-z0-9][a-z0-9.-]*$"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from", "to", "relation"],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^edge:[a-z0-9][a-z0-9.-]*$"},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_id", "graph_type", "version", "content_sha256", "supersedes", "root_or_terminal_node_id", "nodes", "edges"],
      "properties": {
        "graph_id": {"type": "string", "pattern": "^dag:[a-z0-9][a-z0-9.-]*:v[0-9]+$"},
        "graph_type": {"enum": ["execution_plan", "execution_run", "mathematical_obligations", "evidence_admission"]},
        "version": {"type": "integer", "minimum": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "supersedes": {"type": ["string", "null"]},
        "root_or_terminal_node_id": {"type": "string", "minLength": 1},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph", "node"],
      "properties": {
        "graph": {"enum": ["execution_plan", "execution_run", "mathematical_obligations", "evidence_admission"]},
        "node": {"type": "string", "minLength": 1}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "relation", "from", "to"],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^binding:[a-z0-9][a-z0-9.-]*$"},
        "relation": {
          "enum": ["run_implements_plan", "run_acts_on_obligation", "candidate_addresses_obligation", "admission_checks_candidate", "admission_checks_obligation"]
        },
        "from": {"$ref": "#/$defs/endpoint"},
        "to": {"$ref": "#/$defs/endpoint"}
      }
    }
  }
}
