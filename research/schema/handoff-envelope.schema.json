{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/handoff-envelope.v1.json",
  "title": "Vibe Mathing Handoff Envelope",
  "description": "Pure, candidate-only handoff contract for local Pi, Web ChatGPT, GitHub candidate, and Prove2me producers. It is not a ledger record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "outcome",
    "job_id",
    "run_instance_id",
    "dedupe_key",
    "problem_id",
    "problem_contract_sha256",
    "attempt_id",
    "graph_id",
    "obligation_id",
    "route_id",
    "session_id",
    "correlation_id",
    "causation_id",
    "producer",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "envelope_id": {
      "type": "string",
      "pattern": "^handoff:[a-z0-9][a-z0-9.-]*$"
    },
    "outcome": {
      "enum": [
        "candidate",
        "blocked",
        "transport_failure"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^job:[a-z0-9][a-z0-9.-]*$"
    },
    "run_instance_id": {
      "type": "string",
      "pattern": "^(?:run|run-instance):[a-z0-9][a-z0-9.-]*$"
    },
    "dedupe_key": {
      "type": "string",
      "pattern": "^dedupe:[a-z0-9][a-z0-9.-]*$"
    },
    "problem_id": {
      "type": "string",
      "pattern": "^problem:[a-z0-9][a-z0-9.-]*$"
    },
    "problem_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt:[a-z0-9][a-z0-9.-]*$"
    },
    "graph_id": {
      "type": "string",
      "pattern": "^graph:[a-z0-9][a-z0-9.-]*$"
    },
    "obligation_id": {
      "type": "string",
      "pattern": "^obligation:[a-z0-9][a-z0-9.-]*$"
    },
    "route_id": {
      "type": "string",
      "pattern": "^route:[a-z0-9][a-z0-9.-]*$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^session:[a-z0-9][a-z0-9.-]*$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^correlation:[a-z0-9][a-z0-9.-]*$"
    },
    "causation_id": {
      "type": "string",
      "pattern": "^causation:[a-z0-9][a-z0-9.-]*$"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "requested_verification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "source_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "next_obligation": {
      "type": "string",
      "pattern": "^obligation:[a-z0-9][a-z0-9.-]*$"
    },
    "transport": {
      "$ref": "#/$defs/transport"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "title": "Candidate handoff",
          "properties": {
            "outcome": {
              "const": "candidate"
            },
            "producer": {
              "properties": {
                "claim_ceiling": {
                  "const": "candidate_only"
                }
              }
            }
          },
          "required": [
            "candidate",
            "artifact",
            "claims",
            "requested_verification",
            "source_refs"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "blocker"
                ]
              },
              {
                "required": [
                  "next_obligation"
                ]
              },
              {
                "required": [
                  "transport"
                ]
              }
            ]
          }
        },
        {
          "title": "Blocked handoff",
          "properties": {
            "outcome": {
              "const": "blocked"
            },
            "producer": {
              "properties": {
                "claim_ceiling": {
                  "const": "blocked_only"
                }
              }
            }
          },
          "required": [
            "blocker",
            "next_obligation"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "candidate"
                ]
              },
              {
                "required": [
                  "artifact"
                ]
              },
              {
                "required": [
                  "claims"
                ]
              },
              {
                "required": [
                  "requested_verification"
                ]
              },
              {
                "required": [
                  "transport"
                ]
              }
            ]
          }
        },
        {
          "title": "Transport failure handoff",
          "properties": {
            "outcome": {
              "const": "transport_failure"
            },
            "producer": {
              "properties": {
                "claim_ceiling": {
                  "const": "transport_only"
                }
              }
            }
          },
          "required": [
            "transport"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "candidate"
                ]
              },
              {
                "required": [
                  "artifact"
                ]
              },
              {
                "required": [
                  "claims"
                ]
              },
              {
                "required": [
                  "requested_verification"
                ]
              },
              {
                "required": [
                  "blocker"
                ]
              },
              {
                "required": [
                  "next_obligation"
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "fingerprint",
        "fingerprint_status"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "fingerprint_status": {
          "enum": [
            "verified",
            "unverified",
            "unavailable"
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "principal",
        "tool",
        "model",
        "environment",
        "claim_ceiling"
      ],
      "properties": {
        "channel": {
          "enum": [
            "local_pi",
            "web_chatgpt",
            "github_candidate",
            "prove2me"
          ]
        },
        "principal": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 256
        },
        "tool": {
          "$ref": "#/$defs/fingerprint"
        },
        "model": {
          "$ref": "#/$defs/fingerprint"
        },
        "environment": {
          "$ref": "#/$defs/fingerprint"
        },
        "claim_ceiling": {
          "enum": [
            "candidate_only",
            "blocked_only",
            "transport_only"
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "kind",
        "generator",
        "statement_sha256"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^candidate:[a-z0-9][a-z0-9.-]*$"
        },
        "kind": {
          "enum": [
            "proof",
            "counterexample",
            "formalization",
            "computation"
          ]
        },
        "generator": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "statement_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "sha256",
        "media_type"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "pattern": "^research/artifacts/.+"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "status"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim:[a-z0-9][a-z0-9.-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "status": {
          "const": "candidate"
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "retryability"
      ],
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryability": {
          "enum": [
            "retryable",
            "non_retryable",
            "unknown"
          ]
        },
        "stage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        }
      }
    }
  }
}
