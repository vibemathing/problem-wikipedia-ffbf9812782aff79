{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/coordinator-event.schema.json",
  "title": "Vibe Mathing Coordinator Event",
  "description": "An append-only control-plane event. Event metadata never constitutes mathematical Evidence or a Result.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "job_id",
    "run_instance_id",
    "attempt_id",
    "session_id",
    "actor",
    "event_type",
    "correlation_id",
    "causation_id",
    "payload_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"$ref": "#/$defs/identifier"},
    "sequence": {"type": "integer", "minimum": 1},
    "job_id": {"$ref": "#/$defs/identifier"},
    "run_instance_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "actor": {"$ref": "#/$defs/identifier"},
    "event_type": {
      "enum": [
        "created",
        "ready",
        "claimed",
        "started",
        "checkpointed",
        "candidate_created",
        "verifier_requested",
        "verifier_completed",
        "blocked",
        "failed",
        "completed",
        "cancelled"
      ]
    },
    "correlation_id": {"$ref": "#/$defs/identifier"},
    "causation_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 256
    },
    "payload_digest": {"$ref": "#/$defs/digest"},
    "payload": {
      "type": ["object", "array", "string", "number", "boolean", "null"]
    },
    "created_at": {"$ref": "#/$defs/timestamp"}
  }
}
