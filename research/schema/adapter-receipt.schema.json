{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/adapter-receipt.v1.json",
  "title": "Vibe Mathing Runtime Adapter Receipt",
  "description": "A bounded receipt for adapter transport and execution. Its status is deliberately not a mathematical Result or Evidence verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "request_id",
    "request_sha256",
    "adapter_id",
    "adapter_version",
    "channel",
    "status",
    "claim_ceiling",
    "maturity",
    "capabilities",
    "fingerprints",
    "identity",
    "input_digest",
    "transport",
    "execution",
    "mathematical_outcome",
    "created_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {
      "type": "string",
      "pattern": "^adapter-receipt:[a-z0-9][a-z0-9.-]*$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^adapter-request:[a-z0-9][a-z0-9.-]*$"
    },
    "request_sha256": {"$ref": "#/$defs/digest"},
    "adapter_id": {
      "type": "string",
      "pattern": "^adapter:[a-z0-9][a-z0-9.-]*$"
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "channel": {
      "enum": ["local_pi", "web_chatgpt", "github_candidate", "prove2me"]
    },
    "status": {
      "enum": ["delivered", "execution_failed", "transport_failure", "candidate"]
    },
    "claim_ceiling": {
      "enum": ["candidate_only", "blocked_only", "transport_only"]
    },
    "maturity": {
      "enum": [
        "surveyed",
        "source_locked",
        "installed",
        "smoke_checked",
        "evidence_capable",
        "verifier_admitted"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "tool", "model", "environment"],
      "properties": {
        "adapter": {"$ref": "#/$defs/fingerprint"},
        "tool": {"$ref": "#/$defs/fingerprint"},
        "model": {"$ref": "#/$defs/fingerprint"},
        "environment": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "identity": {"$ref": "#/$defs/identity"},
    "input_digest": {"$ref": "#/$defs/digest"},
    "transport": {"$ref": "#/$defs/transport"},
    "execution": {"$ref": "#/$defs/execution"},
    "mathematical_outcome": {
      "enum": ["not_evaluated", "candidate", "blocked", "transport_failure"]
    },
    "handoff": {"type": "object"},
    "handoff_sha256": {"$ref": "#/$defs/digest"},
    "output": {"$ref": "#/$defs/output"},
    "error": {"type": "string", "minLength": 1, "maxLength": 4096},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "candidate"}}},
      "then": {
        "required": ["handoff", "handoff_sha256", "output"],
        "not": {"required": ["error"]},
        "properties": {
          "claim_ceiling": {"const": "candidate_only"},
          "mathematical_outcome": {"const": "candidate"},
          "transport": {
            "properties": {"status": {"const": "delivered"}},
            "required": ["status"]
          },
          "execution": {
            "properties": {"status": {"const": "succeeded"}},
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "execution_failed"}}},
      "then": {
        "required": ["error"],
        "not": {
          "anyOf": [
            {"required": ["handoff"]},
            {"required": ["handoff_sha256"]},
            {"required": ["output"]}
          ]
        },
        "properties": {
          "claim_ceiling": {"const": "transport_only"},
          "mathematical_outcome": {"const": "not_evaluated"},
          "transport": {
            "properties": {"status": {"const": "delivered"}},
            "required": ["status"]
          },
          "execution": {
            "properties": {"status": {"const": "failed"}},
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "transport_failure"}}},
      "then": {
        "required": ["error"],
        "not": {
          "anyOf": [
            {"required": ["handoff"]},
            {"required": ["handoff_sha256"]},
            {"required": ["output"]}
          ]
        },
        "properties": {
          "claim_ceiling": {"const": "transport_only"},
          "mathematical_outcome": {"const": "not_evaluated"},
          "transport": {
            "properties": {"status": {"const": "failed"}},
            "required": ["status"]
          },
          "execution": {
            "properties": {"status": {"const": "not_started"}},
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "delivered"}
        }
      },
      "then": {
        "properties": {
          "transport": {
            "properties": {"status": {"const": "delivered"}},
            "required": ["status"]
          },
          "execution": {
            "properties": {"status": {"enum": ["pending", "succeeded"]}},
            "required": ["status"]
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 512},
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "fingerprint", "fingerprint_status"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "fingerprint": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "fingerprint_status": {
          "enum": ["verified", "unverified", "unavailable"]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinator_id",
        "job_id",
        "run_instance_id",
        "attempt_id",
        "graph_id",
        "obligation_id",
        "route_id",
        "session_id",
        "correlation_id",
        "causation_id",
        "dedupe_key",
        "problem_id",
        "problem_contract_sha256"
      ],
      "properties": {
        "coordinator_id": {
          "type": "string",
          "pattern": "^coordinator:[a-z0-9][a-z0-9.-]*$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^project:[a-z0-9][a-z0-9.-]*$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^job:[a-z0-9][a-z0-9.-]*$"
        },
        "run_instance_id": {
          "type": "string",
          "pattern": "^(?:run|run-instance):[a-z0-9][a-z0-9.-]*$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^attempt:[a-z0-9][a-z0-9.-]*$"
        },
        "graph_id": {
          "type": "string",
          "pattern": "^graph:[a-z0-9][a-z0-9.-]*$"
        },
        "obligation_id": {
          "type": "string",
          "pattern": "^obligation:[a-z0-9][a-z0-9.-]*$"
        },
        "route_id": {
          "type": "string",
          "pattern": "^route:[a-z0-9][a-z0-9.-]*$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^session:[a-z0-9][a-z0-9.-]*$"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^correlation:[a-z0-9][a-z0-9.-]*$"
        },
        "causation_id": {
          "type": "string",
          "pattern": "^causation:[a-z0-9][a-z0-9.-]*$"
        },
        "dedupe_key": {
          "type": "string",
          "pattern": "^dedupe:[a-z0-9][a-z0-9.-]*$"
        },
        "problem_id": {
          "type": "string",
          "pattern": "^problem:[a-z0-9][a-z0-9.-]*$"
        },
        "problem_contract_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempted"],
      "properties": {
        "status": {"enum": ["delivered", "failed", "not_attempted"]},
        "attempted": {"type": "boolean"},
        "stage": {"type": "string", "minLength": 1, "maxLength": 256},
        "error": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "succeeded", "failed", "not_started"]},
        "output_digest": {"$ref": "#/$defs/digest"},
        "error": {"type": "string", "minLength": 1, "maxLength": 4096},
        "completed_phases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "all_phases_completed": {"type": "boolean"},
        "root_status": {"type": "string", "minLength": 1, "maxLength": 256},
        "done": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "sha256"],
      "properties": {
        "media_type": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
