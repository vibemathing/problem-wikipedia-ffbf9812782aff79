{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/coordinator-dependency.schema.json",
  "title": "Vibe Mathing Coordinator Job Dependency Contract",
  "description": "A deterministic execution dependency contract. It is control-plane metadata and is not a mathematical obligation graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "job_id",
    "all_of",
    "any_of",
    "terminal_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "workflow_id": {"$ref": "#/$defs/identifier"},
    "job_id": {"$ref": "#/$defs/identifier"},
    "all_of": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dependency_ref"}
    },
    "any_of": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dependency_ref"}
    },
    "terminal_policy": {"$ref": "#/$defs/terminal_policy"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "job_status": {
      "enum": [
        "new",
        "ready",
        "claimed",
        "started",
        "checkpointed",
        "candidate_ready",
        "verifying",
        "verifier_completed",
        "completed",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "terminal_status": {
      "enum": ["completed", "blocked", "failed", "cancelled"]
    },
    "dependency_ref": {
      "oneOf": [
        {"$ref": "#/$defs/identifier"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["job_id"],
          "properties": {
            "job_id": {"$ref": "#/$defs/identifier"},
            "workflow_id": {"$ref": "#/$defs/identifier"}
          }
        }
      ]
    },
    "terminal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success_statuses", "failure_statuses", "failure_action"],
      "properties": {
        "success_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/terminal_status"}
        },
        "failure_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/terminal_status"}
        },
        "failure_action": {
          "enum": ["block", "wait"]
        }
      }
    }
  }
}
