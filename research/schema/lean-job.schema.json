{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/lean-job.v1.json",
  "title": "Vibe Mathing Bounded Lean Job",
  "description": "A bounded, candidate-only Lean operation. Coordinator identity is deliberately separate from the Lean job identity; this object never writes Evidence or Result ledgers.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256"],
      "properties": {
        "locator": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/digest"},
        "media_type": {"$ref": "#/$defs/text"}
      }
    },
    "principal": {
      "anyOf": [
        {"$ref": "#/$defs/text"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "role"],
          "properties": {
            "id": {"$ref": "#/$defs/text"},
            "role": {"enum": ["generator", "verifier", "coordinator"]}
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_seconds", "max_output_bytes", "max_retries"],
      "properties": {
        "wall_time_seconds": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "max_memory_bytes": {"type": "integer", "minimum": 1},
        "cpu_seconds": {"type": "integer", "minimum": 1},
        "max_cpu_seconds": {"type": "integer", "minimum": 1},
        "max_output_bytes": {"type": "integer", "minimum": 1},
        "max_files": {"type": "integer", "minimum": 1},
        "max_retries": {"type": "integer", "minimum": 0}
      }
    },
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "run_instance_id", "session_id", "attempt_id", "dedupe_key"],
      "properties": {
        "job_id": {"$ref": "#/$defs/identifier"},
        "run_instance_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "attempt_id": {"$ref": "#/$defs/identifier"},
        "dedupe_key": {"$ref": "#/$defs/identifier"}
      }
    },
    "failure_class": {
      "type": ["string", "null"],
      "enum": [
        null,
        "TOOLCHAIN_UNAVAILABLE",
        "ENVIRONMENT_MISMATCH",
        "PARSE_ERROR",
        "ELABORATION_ERROR",
        "PROOF_GAP",
        "SORRY_OR_ADMIT",
        "AXIOM_ESCAPE",
        "SELF_REFERENCE",
        "STATEMENT_MISMATCH",
        "TIMEOUT",
        "RESOURCE_EXCEEDED",
        "TRANSPORT_FAILURE",
        "EXTERNAL_VERDICT_UNREPLAYED",
        "KERNEL_REJECTED",
        "FAITHFULNESS_NEEDS_REVIEW",
        "CHECKER_ERROR",
        "TOOL_ERROR"
      ]
    }
  },
  "required": [
    "schema_version",
    "lean_job_id",
    "package_id",
    "operation",
    "principal",
    "trust_domain",
    "readonly_inputs",
    "command_allowlist",
    "expected_artifacts",
    "write_scopes",
    "network_policy",
    "input_digest",
    "status",
    "failure_class",
    "correlation_id",
    "causation_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "lean_job_id": {"$ref": "#/$defs/identifier"},
    "job_id": {"$ref": "#/$defs/identifier"},
    "package_id": {"$ref": "#/$defs/identifier"},
    "problem_id": {"$ref": "#/$defs/identifier"},
    "problem_contract_sha256": {"$ref": "#/$defs/digest"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "operation": {"enum": ["generate", "repair", "replay", "axiom_audit", "faithfulness_review"]},
    "principal": {"$ref": "#/$defs/principal"},
    "trust_domain": {"$ref": "#/$defs/text"},
    "coordinator_identity": {"$ref": "#/$defs/coordinator"},
    "coordinator_job_id": {"$ref": "#/$defs/identifier"},
    "coordinator_run_instance_id": {"$ref": "#/$defs/identifier"},
    "coordinator_session_id": {"$ref": "#/$defs/identifier"},
    "coordinator_attempt_id": {"$ref": "#/$defs/identifier"},
    "coordinator_dedupe_key": {"$ref": "#/$defs/identifier"},
    "run_instance_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "dedupe_key": {"$ref": "#/$defs/identifier"},
    "readonly_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "budgets": {"$ref": "#/$defs/budget"},
    "budget": {"$ref": "#/$defs/budget"},
    "command_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {"$ref": "#/$defs/text"},
          {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/text"}
          }
        ]
      }
    },
    "expected_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "write_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "network_policy": {"const": "disabled"},
    "execution_profile": {"type": "object"},
    "input_digest": {"$ref": "#/$defs/digest"},
    "output_digest": {"$ref": "#/$defs/digest"},
    "status": {
      "enum": ["planned", "ready", "running", "checkpointed", "completed", "checked", "rejected", "blocked", "failed", "tool_error", "cancelled"]
    },
    "failure_class": {"$ref": "#/$defs/failure_class"},
    "retry_count": {"type": "integer", "minimum": 0},
    "correlation_id": {"$ref": "#/$defs/identifier"},
    "causation_id": {"type": ["string", "null"], "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "anyOf": [
        {"required": ["coordinator_identity"]},
        {"required": ["coordinator_job_id", "coordinator_run_instance_id", "coordinator_session_id", "coordinator_attempt_id", "coordinator_dedupe_key"]},
        {"required": ["job_id", "run_instance_id", "session_id", "attempt_id", "dedupe_key"]}
      ]
    },
    {
      "anyOf": [
        {"required": ["budgets"]},
        {"required": ["budget"]}
      ]
    }
  ]
}
