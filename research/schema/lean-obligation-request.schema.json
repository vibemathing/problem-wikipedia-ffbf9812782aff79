{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded Lean Obligation Verification Request",
  "required": [
    "candidate_id",
    "source_files",
    "verifiers",
    "graph_id",
    "allowed_axioms",
    "module",
    "budgets",
    "obligation_id",
    "fixture_root",
    "execution_profile",
    "trusted_challenge",
    "schema_version",
    "declaration",
    "expected_declaration"
  ],
  "properties": {
    "graph_id": {
      "type": "string",
      "pattern": "^graph:[a-z0-9][a-z0-9.-]*$"
    },
    "allowed_axioms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "module": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_output_bytes",
        "max_memory_bytes"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "max_memory_bytes": {
          "type": "integer",
          "minimum": 67108864
        }
      }
    },
    "fixture_root": {
      "type": "string",
      "minLength": 1
    },
    "obligation_id": {
      "type": "string",
      "pattern": "^obligation:[a-z0-9][a-z0-9.-]*$"
    },
    "execution_profile": {
      "const": "trusted_fixture_native"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^candidate:[a-z0-9][a-z0-9.-]*$"
    },
    "declaration": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_'.]*$"
    },
    "expected_declaration": {
      "type": "string",
      "minLength": 1
    },
    "verifiers": {
      "type": "object",
      "required": [
        "kernel_check",
        "axiom_escape_audit"
      ],
      "properties": {
        "kernel_check": {
          "type": "string",
          "minLength": 1
        },
        "statement_identity": {
          "type": "string",
          "minLength": 1
        },
        "statement_faithfulness": {
          "type": "string",
          "minLength": 1
        },
        "axiom_escape_audit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "statement_faithfulness"
          ]
        },
        {
          "required": [
            "statement_identity"
          ]
        }
      ]
    },
    "trusted_challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "module",
        "statement_constant",
        "sha256"
      ],
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
        },
        "statement_constant": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_'.]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$id": "https://vibe-mathing.local/schema/lean-obligation-request.v1.json",
  "additionalProperties": false
}
