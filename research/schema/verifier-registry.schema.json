{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe Mathing Verifier Registry",
  "required": [
    "schema_version",
    "principals"
  ],
  "properties": {
    "principals": {
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "trust_domain",
          "policy",
          "capabilities"
        ],
        "properties": {
          "native_input_trust": {
            "enum": [
              "denied",
              "trusted_fixture_native"
            ]
          },
          "trust_domain": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "role": {
            "enum": [
              "generator",
              "verifier"
            ]
          },
          "policy": {
            "type": [
              "string",
              "null"
            ]
          },
          "toolchain_allowlist": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version",
                "fingerprint"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "fingerprint": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "trusted_challenge_allowlist": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "generator"
                },
                "native_input_trust": {
                  "const": "trusted_fixture_native"
                }
              },
              "required": [
                "role",
                "native_input_trust"
              ]
            },
            "then": {
              "required": [
                "trusted_challenge_allowlist"
              ],
              "properties": {
                "trusted_challenge_allowlist": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "$id": "https://vibe-mathing.local/schema/verifier-registry.schema.json",
  "additionalProperties": false
}
