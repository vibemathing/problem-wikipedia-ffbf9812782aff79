{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/candidate-lineage-event.v1.json",
  "title": "Vibe Mathing Append-only Candidate Lineage Event",
  "description": "An immutable relation between already-created Candidate/EvidenceLink objects. It changes only the derived projection; it never rewrites or deletes truth records.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "problemId": {
      "type": "string",
      "pattern": "^problem:[a-z0-9][a-z0-9.-]*$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^attempt:[a-z0-9][a-z0-9.-]*$"
    },
    "graphId": {
      "type": "string",
      "pattern": "^graph:[a-z0-9][a-z0-9.-]*$"
    },
    "obligationId": {
      "type": "string",
      "pattern": "^obligation:[a-z0-9][a-z0-9.-]*$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^candidate:[a-z0-9][a-z0-9.-]*$"
    },
    "evidenceLinkId": {
      "type": "string",
      "pattern": "^evidence-link:[a-z0-9][a-z0-9.-]*$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^lineage-event:[a-z0-9][a-z0-9.-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "candidateNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"const": "candidate"},
        "id": {"$ref": "#/$defs/candidateId"}
      }
    },
    "evidenceLinkNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"const": "evidence_link"},
        "id": {"$ref": "#/$defs/evidenceLinkId"}
      }
    },
    "lineageNode": {
      "oneOf": [
        {"$ref": "#/$defs/candidateNode"},
        {"$ref": "#/$defs/evidenceLinkNode"}
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "graph_id",
    "problem_id",
    "attempt_id",
    "obligation_id",
    "source",
    "target",
    "reason",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"$ref": "#/$defs/eventId"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {
      "enum": ["supersedes", "retracts", "invalidates"]
    },
    "graph_id": {"$ref": "#/$defs/graphId"},
    "problem_id": {"$ref": "#/$defs/problemId"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "obligation_id": {"$ref": "#/$defs/obligationId"},
    "source": {"$ref": "#/$defs/lineageNode"},
    "target": {"$ref": "#/$defs/lineageNode"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "source_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "supersedes"}}},
      "then": {
        "properties": {
          "source": {"$ref": "#/$defs/candidateNode"},
          "target": {"$ref": "#/$defs/candidateNode"}
        }
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "invalidates"}}},
      "then": {
        "oneOf": [
          {
            "properties": {
              "source": {"$ref": "#/$defs/candidateNode"},
              "target": {"$ref": "#/$defs/candidateNode"}
            }
          },
          {
            "properties": {
              "source": {"$ref": "#/$defs/evidenceLinkNode"},
              "target": {"$ref": "#/$defs/evidenceLinkNode"}
            }
          }
        ]
      }
    }
  ]
}
