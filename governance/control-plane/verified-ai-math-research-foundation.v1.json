    {"id": "FND-07", "name": "kernel_and_statement_faithfulness_conjunction", "faces": ["F08", "F09", "F10"], "enforcement": "admission_gate"},
    {"id": "FND-08", "name": "proof_refutation_symmetry_with_domain_witness", "faces": ["F03", "F08", "F09", "F10"], "enforcement": "admission_gate"},
    {"id": "FND-09", "name": "independent_replay_and_provenance", "faces": ["F09", "F10"], "enforcement": "validator"},
